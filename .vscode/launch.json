{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Remote Debug: diagnostics",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Target-Debug/cpp/diagnostics/hsc-diagnostics",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/hammerhead/1.0/sysroots/x86_64-pokysdk-linux/usr/bin/aarch64-poky-linux/aarch64-poky-linux-gdb",
            "miDebuggerServerAddress": "${config:hammerhead.targetHost}:${config:hammerhead.gdbPort}",
            "preLaunchTask": "GDB Server: diagnostics",
            "setupCommands": [
                {
                    "description": "Resolve target shared libraries from the SDK sysroot",
                    "text": "set sysroot /opt/hammerhead/1.0/sysroots/cortexa76-poky-linux",
                    "ignoreFailures": false
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
