{
  "name": "Hammerhead Sensor Module Dev Container",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "runArgs": [
    "--privileged"
  ],
  "mounts": [
    "source=/dev/bus/usb,target=/dev/bus/usb,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "xaver.clang-format",
        "CS128.cs128-clang-tidy"
      ]
    }
  }
}
